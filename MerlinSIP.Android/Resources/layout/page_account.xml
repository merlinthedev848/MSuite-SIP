<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIP account"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter the same server, extension, and password you use on the desk phone. Merlin stays registered while this app is running."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView style="@style/FieldLabel" android:text="Display name" />
        <EditText
            android:id="@+id/display_name"
            style="@style/FieldInput"
            android:hint="Optional"
            android:inputType="textPersonName" />

        <TextView style="@style/FieldLabel" android:text="SIP server" />
        <EditText
            android:id="@+id/server"
            style="@style/FieldInput"
            android:hint="pbx.example.com"
            android:inputType="textUri" />

        <TextView style="@style/FieldLabel" android:text="Port" />
        <EditText
            android:id="@+id/port"
            style="@style/FieldInput"
            android:hint="5060"
            android:inputType="number"
            android:text="5060" />

        <TextView style="@style/FieldLabel" android:text="Domain" />
        <EditText
            android:id="@+id/domain"
            style="@style/FieldInput"
            android:hint="Leave blank to use the server"
            android:inputType="textUri" />

        <TextView style="@style/FieldLabel" android:text="Extension" />
        <EditText
            android:id="@+id/extension"
            style="@style/FieldInput"
            android:hint="1001"
            android:inputType="text" />

        <TextView style="@style/FieldLabel" android:text="Auth username" />
        <EditText
            android:id="@+id/username"
            style="@style/FieldInput"
            android:hint="Leave blank to use the extension"
            android:inputType="text" />

        <TextView style="@style/FieldLabel" android:text="Password" />
        <EditText
            android:id="@+id/password"
            style="@style/FieldInput"
            android:hint="SIP password"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/account_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/register_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_amber"
            android:text="Save and register"
            android:textAllCaps="false"
            android:textColor="@color/amber_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/signout_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_outline"
            android:text="Sign out"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

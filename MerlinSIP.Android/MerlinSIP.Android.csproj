    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MerlinSip.Mobile</RootNamespace>
    <AssemblyName>MerlinSIP</AssemblyName>
    <ApplicationId>uk.co.ckmediaservices.merlinsip</ApplicationId>

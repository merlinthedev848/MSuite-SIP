DirectoryIndex index.php
Options -Indexes

<IfModule mod_headers.c>
  Header always set Permissions-Policy "microphone=(self), speaker-selection=(self)"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType audio/wav .wav
  AddType audio/ogg .ogg
  AddType audio/mpeg .mp3
</IfModule>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>




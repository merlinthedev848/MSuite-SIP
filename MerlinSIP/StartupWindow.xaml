<Window x:Class="MerlinSip.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP Setup"
        Icon="Assets/CKMedia-Icon.ico"
        Width="560"
        Height="780"
        MinWidth="520"
        MinHeight="660"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent">
    <Border Background="#F4F7FB" CornerRadius="22" BorderBrush="#D7E1EC" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.18" Color="#07111E" />
        </Border.Effect>
        <Grid Margin="20" MaxWidth="620" HorizontalAlignment="Center">
            <Border Style="{StaticResource PanelStyle}" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <Grid Margin="0,0,0,14">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="14"
                                Background="#101622"
                                HorizontalAlignment="Left">
                            <Image Source="Assets/CKMedia-Icon.png" Width="34" Height="34" Stretch="Uniform" />
                        </Border>
                        <Button Content="Close"
                                HorizontalAlignment="Right"
                                Width="80"
                                Padding="10,7"
                                Click="CancelButton_Click" />
                    </Grid>
                    <TextBlock Text="Merlin SIP"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Enter your 8-digit provisioning code to activate and connect."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <!-- Mode A: Single-Code Auto-Provisioning (Default) -->
                        <StackPanel x:Name="ProvisionCodePanel">
                            <TextBlock Text="8-Digit Provisioning Code" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                            <TextBox x:Name="ProvisioningCodeTextBox"
                                     Margin="0,6,0,8"
                                     MaxLength="8"
                                     FontSize="20"
                                     FontWeight="Bold"
                                     TextAlignment="Center" />
                            <TextBlock Text="Enter the 8-digit code issued by your PBX administrator. Your extension credentials and software licence will be activated together in one step."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,14"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Mode B: Manual SIP / Standalone Licence Details -->
                        <StackPanel x:Name="ManualSipPanel" Visibility="Collapsed">
                            <TextBlock Text="Standalone Licence Key" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                            <TextBox x:Name="LicenseKeyTextBox"
                                     Margin="0,6,0,8"
                                     CharacterCasing="Upper"
                                     FontSize="14" />

                            <StackPanel x:Name="PrivatePbxPanel" Visibility="Collapsed">
                                <TextBlock Text="SIP Server / Domain" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                                <TextBox x:Name="PrivatePbxTextBox" Margin="0,6,0,12" />
                            </StackPanel>

                            <TextBlock Text="Extension or User ID" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                            <TextBox x:Name="ExtensionTextBox" Margin="0,6,0,12" />

                            <TextBlock Text="Authentication Username" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                            <TextBox x:Name="UsernameTextBox" Margin="0,6,0,12" />

                            <TextBlock Text="Password / Secret" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                            <PasswordBox x:Name="PasswordBox" Margin="0,6,0,12" />
                        </StackPanel>

                        <!-- Common Audio Devices Configuration -->
                        <TextBlock Text="Audio input" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" Margin="0,4,0,0" />
                        <ComboBox x:Name="AudioInputComboBox"
                                  Margin="0,6,0,12"
                                  BorderBrush="#D4C9B3"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="Audio output" Foreground="{StaticResource MutedBrush}" FontWeight="Medium" />
                        <ComboBox x:Name="AudioOutputComboBox"
                                  Margin="0,6,0,12"
                                  BorderBrush="#D4C9B3"
                                  DisplayMemberPath="Name" />

                        <!-- Mode Switch Toggle Button -->
                        <Button x:Name="SwitchModeButton"
                                Content="Need manual SIP setup or standalone licence key? Click here"
                                Click="SwitchModeButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#2563EB"
                                Cursor="Hand"
                                FontSize="12"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0" />

                        <TextBlock x:Name="ErrorText"
                                   Foreground="#B82F2F"
                                   FontWeight="Medium"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Margin="0,0,8,0"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Foreground="#334155"
                            FontWeight="SemiBold">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04" Color="#0F172A" />
                        </Button.Effect>
                    </Button>
                    <Button Grid.Column="1"
                            x:Name="ContinueButton"
                            Content="Activate &amp; Connect"
                            Background="{StaticResource PrimaryGradientBrush}"
                            BorderBrush="#D97706"
                            BorderThickness="1"
                            Foreground="#0F172A"
                            FontWeight="Bold"
                            Click="ContinueButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#D97706" />
                        </Button.Effect>
                    </Button>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="MerlinSip.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP"
        Icon="Assets/CKMedia-Icon.ico"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="18"
            Background="#FCFEFF"
            BorderBrush="#D8E1EE"
            BorderThickness="1"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.18" Color="#07111E" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
<Button DockPanel.Dock="Right"
                        Width="32"
                        Height="32"
                        Cursor="Hand"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Click="CancelButton_Click"
                        ToolTip="Close"
                        AutomationProperties.Name="Close Window">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseCircle" Width="32" Height="32" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseCircle" Property="Background" Value="#E2E8F0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Confirm"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Merlin SIP"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1"
                       x:Name="MessageTextBlock"
                       TextWrapping="Wrap"
                       Foreground="#334155"
                       FontSize="14"
                       LineHeight="20"
                       Margin="0,22,0,24" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="CancelButton"
                        Content="Cancel"
                        Height="42"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="1"
                        x:Name="ConfirmButton"
                        Content="Confirm"
                        Height="42"
                        Margin="8,0,0,0"
                        Background="{StaticResource PrimaryGradientBrush}"
                        Foreground="White"
                        Click="ConfirmButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>

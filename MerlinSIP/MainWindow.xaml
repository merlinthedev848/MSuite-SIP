<Window x:Class="MerlinSip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP"
        Width="1420"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#111317">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F9FAFB" Offset="0" />
            <GradientStop Color="#F9FAFB" Offset="0.56" />
            <GradientStop Color="#F3F4F6" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#FFFFFF" Offset="0.62" />
            <GradientStop Color="#F9FAFB" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DialFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F3F4F6" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideRailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1C1917" Offset="0" />
            <GradientStop Color="#111317" Offset="0.64" />
            <GradientStop Color="#0C0A09" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FCD34D" Offset="0" />
            <GradientStop Color="#FBBF24" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF4444" Offset="0" />
            <GradientStop Color="#B91C1C" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.08" Color="#1E293B" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111317" />
            <Setter Property="Background" Value="{StaticResource DialFaceBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.06" Color="#1E293B" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FCD34D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.03" Color="#1E293B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeypadButton" TargetType="Button">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxHeight" Value="58" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04" Color="#0F172A" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyChrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="KeyChrome" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="KeyChrome" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedTabButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="LineActionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04" Color="#0F172A" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineIconActionButton" TargetType="Button" BasedOn="{StaticResource LineActionButton}" />

        <Style x:Key="LineDangerActionButton" TargetType="Button" BasedOn="{StaticResource LineActionButton}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.16" Color="#B91C1C" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DC2626" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineDangerIconActionButton" TargetType="Button" BasedOn="{StaticResource LineDangerActionButton}" />

        <Style x:Key="LineSuccessActionButton" TargetType="Button" BasedOn="{StaticResource LineActionButton}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#059669" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.16" Color="#047857" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#059669" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#047857" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineSuccessIconActionButton" TargetType="Button" BasedOn="{StaticResource LineSuccessActionButton}" />

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource DialButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="IconSoftButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

                <Style x:Key="MerlinBetaNavButton" TargetType="Button">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContactCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#1E293B" />
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#1E293B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FCD34D" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#1E293B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#1E293B" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#FEF3C7" />
                                <Setter Property="Foreground" Value="#D97706" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresenceContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#0F172A" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresenceMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

            <Style x:Key="SettingsInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#0E987E" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>

    <Grid Background="{StaticResource AppBackdrop}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SideRailBrush}" Padding="6,16" BorderThickness="0,0,1,0" BorderBrush="#1F2937">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="46" Height="46" CornerRadius="10" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                        </Border.Effect>
                        <Image Source="Assets/CKMedia-Icon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Merlin" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" TextAlignment="Center" />
                    <TextBlock Text="Beta" Foreground="#F59E0B" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Button Style="{StaticResource MerlinBetaNavButton}" Click="ShowDialButton_Click" ToolTip="Keypad &amp; Active Calls" AutomationProperties.Name="Keypad">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE75F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="#FCD34D" HorizontalAlignment="Center" />
                            <TextBlock Text="Keypad" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MerlinBetaNavButton}" Click="ShowCallsButton_Click" ToolTip="Recent Call History" AutomationProperties.Name="Recents">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Text="Recents" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MerlinBetaNavButton}" Click="ShowContactsButton_Click" ToolTip="Contacts Directory" AutomationProperties.Name="Contacts">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Text="Contacts" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MerlinBetaNavButton}" Click="ShowMessagesButton_Click" ToolTip="Instant Messaging &amp; SMS" AutomationProperties.Name="Messages">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Text="Messages" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MerlinBetaNavButton}" Click="OpenSettingsButton_Click" ToolTip="Settings &amp; Audio Preferences" AutomationProperties.Name="Settings">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <TextBlock x:Name="LicenseStatusText"
                               Text="Licensed"
                               Foreground="#8FA0B7"
                               FontSize="9"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AppVersionText"
                               Text="v1.3.5"
                               Foreground="#64748B"
                               FontSize="9"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="NoticeText" Text="" Foreground="#059669" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
                </StackPanel>

                <!-- Unified Search / Dial Bar -->
                <Border Grid.Column="1"
                        MaxWidth="460"
                        HorizontalAlignment="Left"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.05" Color="#0F172A" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   x:Name="GlobalSearchPlaceholder"
                                   Text="Search contacts, history, or dial number..."
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   IsHitTestVisible="False" />
                        <TextBox Grid.Column="1"
                                 x:Name="GlobalSearchTextBox"
                                 Height="28"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 ToolTip="Search contacts or dial number, then press Enter"
                                 TextChanged="GlobalSearchTextBox_TextChanged"
                                 KeyDown="GlobalSearchTextBox_KeyDown" />
                        <Button Grid.Column="2"
                                x:Name="GlobalSearchClearButton"
                                Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="#94A3B8"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,0"
                                Margin="4,0,0,0"
                                Visibility="Collapsed"
                                Click="GlobalSearchClearButton_Click"
                                ToolTip="Clear search" />
                    </Grid>
                </Border>

                <!-- Top Right Header: Auto Answer + DND + User Badge / Presence -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto Answer Quick Toggle -->
                    <Border x:Name="AutoAnswerPill"
                            Background="#F1F5F9"
                            CornerRadius="14"
                            Padding="8,5"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="AutoAnswerPill_MouseDown"
                            ToolTip="Click to toggle Auto-Answer for incoming calls">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="AutoAnswerDot" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AutoAnswerText" Text="Auto Answer: OFF" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- DND Quick Toggle -->
                    <Border x:Name="DndPill"
                            Background="#F1F5F9"
                            CornerRadius="14"
                            Padding="8,5"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="DndPill_MouseDown"
                            ToolTip="Click to toggle Do Not Disturb (DND)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DndDot" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="DndText" Text="DND: OFF" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Unified User Profile & Presence Pill -->
                    <Border x:Name="UserPresencePill"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="5,4,12,4"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="UserPresencePill_MouseDown"
                            ToolTip="Click to change your presence status">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#0F172A" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Avatar / Icon circle -->
                            <Border Width="28" Height="28" CornerRadius="14" Background="#2563EB" Margin="0,0,8,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserAvatarIcon"
                                               Text="&#xE77B;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="UserAvatarText"
                                               Text="CK"
                                               Foreground="#FFFFFF"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <!-- User info & Presence status -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="UserDisplayNameText" Text="Ext 503" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Ellipse x:Name="HeaderPresenceDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeaderPresenceText" Text="Available" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                    <!-- Keep HeaderSipStatusText collapsed for backwards-compat -->
                                    <TextBlock x:Name="HeaderSipStatusText" Text="" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Subtle dropdown chevron -->
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />

                            <!-- Hidden elements to preserve code bindings if any -->
                            <Ellipse x:Name="PresenceDot" Width="0" Height="0" Visibility="Collapsed" />
                            <TextBlock x:Name="PresenceText" Text="Available" Visibility="Collapsed" />
                        </StackPanel>

                        <Border.ContextMenu>
                            <ContextMenu x:Name="PresenceContextMenu"
                                         Style="{StaticResource PresenceContextMenuStyle}"
                                         PlacementTarget="{Binding ElementName=UserPresencePill}"
                                         Placement="Custom"
                                         >
                                <MenuItem Tag="Available" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Available">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center" MinWidth="140">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#10B981" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Available" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="Busy" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Busy">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center" MinWidth="140">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Busy" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="DND" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Do Not Disturb">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center" MinWidth="140">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#DC2626" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Rectangle Width="9" Height="2" Fill="White" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="DND" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="Away" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Away">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center" MinWidth="140">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#10B981" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Away" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="Offline" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Offline">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center" MinWidth="140">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Offline" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Reduced Functionality / Disconnection Alert Banner (Agilico Style: Only shown when disconnected or encountering error) -->
            <Border x:Name="ServerAlertBanner"
                    Grid.Row="1"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,9"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Border Width="20" Height="20" CornerRadius="10" Background="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ServerAlertText"
                               Text="Reduced Functionality: Attempting to reconnect to the server, call functionality temporarily unavailable."
                               Foreground="#991B1B"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>
                <TabItem x:Name="PhoneTab" Header="Phone">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Row 0: Header "Calls" -->
                                    <RowDefinition Height="Auto" /> <!-- Row 1: Dual Lines Box -->
                                    <RowDefinition Height="Auto" /> <!-- Row 2: Queue Line Box -->
                                    <RowDefinition Height="Auto" /> <!-- Row 3: Dial Header -->
                                    <RowDefinition Height="Auto" /> <!-- Row 4: DestinationTextBox & Clear -->
                                    <RowDefinition Height="*" MinHeight="150" /> <!-- Row 5: Keypad (flexes to fit) -->
                                    <RowDefinition Height="Auto" /> <!-- Row 6: Dial / Redial / Hangup -->
                                    <RowDefinition Height="Auto" /> <!-- Row 7: InCall & Quick Actions -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Top Header: Calls + Audio/Timer/Quality -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Live Call Quality Icon Button (Agilico Connect Style) -->
                                        <Border x:Name="CallQualityPill"
                                                Background="#F0FDF4"
                                                BorderBrush="#BBF7D0"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,5"
                                                Margin="0,0,6,0"
                                                Cursor="Hand"
                                                MouseDown="LiveCallStatisticsCard_MouseDown"
                                                ToolTip="Check live call quality analysis (MOS, jitter, latency, packet loss)"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="CallQualityIcon"
                                                       Text="&#xE9D2;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="#0E987E"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="CallTimerPill"
                                                Background="#FFE2E2"
                                                CornerRadius="7"
                                                Padding="9,4"
                                                Margin="0,0,8,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="CallTimerText" Text="Inactive" FontWeight="SemiBold" Foreground="#9B1C1C" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" ToolTip="Audio Headset Ready" />
                                    </StackPanel>
                                    <TextBlock Text="Calls" Foreground="#111827" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- ROW 1: DUAL-LINE CALLS CONTAINER (Agilico Style: Line 1 & Line 2) -->
                                <Border x:Name="LinesContainer"
                                        Grid.Row="1"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,12"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" MinHeight="56" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" MinHeight="56" />
                                        </Grid.RowDefinitions>

                                        <!-- LINE 1 -->
                                        <Border x:Name="Line1Card"
                                                Grid.Row="0"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="0"
                                                CornerRadius="9,9,0,0"
                                                Padding="14,10"
                                                Cursor="Hand"
                                                MouseDown="Line1Card_MouseDown"
                                                ToolTip="Line 1 (Click to select)">
                                            <StackPanel VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Line 1 Number Indicator on the right (Agilico '1') -->
                                                    <Border DockPanel.Dock="Right" x:Name="Line1Badge" Width="28" Height="28" CornerRadius="14" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,4,0">
                                                        <TextBlock x:Name="Line1BadgeText"
                                                                   Text="1"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#475569"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Line 1 Status & Caller Info -->
                                                    <StackPanel x:Name="Line1InfoPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="Line1StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="Line1Title" Text="Line 1" FontWeight="Bold" FontSize="13" Foreground="#111827" Margin="0,0,8,0" Visibility="Collapsed" />
                                                        <TextBlock x:Name="Line1StatusText" Text="Line 1  •  Ready" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                                        <Border x:Name="Line1VideoBadge" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" Visibility="Collapsed" Cursor="Hand" MouseDown="VideoBadge_MouseDown" ToolTip="Active Yeastar Video Call (Click to open video window)">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#7C3AED" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Video" FontSize="10" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock x:Name="Line1DetailText" Text="" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Line 1 In-Call Controls Row (High-Quality Segoe Icons) -->
                                                <UniformGrid x:Name="Line1ActionRow" Columns="6" Height="32" Margin="0,8,0,2" Visibility="Collapsed" TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="14">
                                                    <Button x:Name="Line1HoldResumeButton" Content="&#xE769;" Style="{StaticResource LineIconActionButton}" Click="Line1HoldResumeButton_Click" ToolTip="Hold Call" />
                                                    <Button x:Name="Line1MuteButton" Content="&#xE720;" Style="{StaticResource LineIconActionButton}" Click="Line1MuteButton_Click" ToolTip="Mute Microphone" />
                                                    <Button x:Name="Line1TransferButton" Content="&#xE72A;" Style="{StaticResource LineIconActionButton}" Click="Line1TransferButton_Click" ToolTip="Transfer Call" />
                                                    <Button x:Name="Line1ConferenceButton" Content="&#xE716;" Style="{StaticResource LineIconActionButton}" Click="Line1ConferenceButton_Click" ToolTip="Conference Calls" />
                                                    <Button x:Name="Line1RecordButton" Content="&#xE7C8;" Style="{StaticResource LineIconActionButton}" Click="Line1RecordButton_Click" ToolTip="Record Call" />
                                                    <Button x:Name="Line1HangupButton" Content="&#xE778;" Style="{StaticResource LineDangerIconActionButton}" Click="Line1HangupButton_Click" ToolTip="End Call" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Divider Line -->
                                        <Rectangle x:Name="LinesDivider" Grid.Row="1" Fill="#E2E8F0" Height="1" />

                                        <!-- LINE 2 -->
                                        <Border x:Name="Line2Card"
                                                Grid.Row="2"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="0"
                                                CornerRadius="0,0,9,9"
                                                Padding="14,10"
                                                Cursor="Hand"
                                                MouseDown="Line2Card_MouseDown"
                                                ToolTip="Line 2 (Click to select for second call or answering incoming)">
                                            <StackPanel VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Line 2 Number Indicator on the right (Agilico '2') -->
                                                    <Border DockPanel.Dock="Right" x:Name="Line2Badge" Width="28" Height="28" CornerRadius="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,4,0">
                                                        <TextBlock x:Name="Line2BadgeText"
                                                                   Text="2"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#94A3B8"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Line 2 Status & Caller Info -->
                                                    <StackPanel x:Name="Line2InfoPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="Line2StatusDot" Width="8" Height="8" Fill="#CBD5E1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="Line2Title" Text="Line 2" FontWeight="Bold" FontSize="13" Foreground="#111827" Margin="0,0,8,0" Visibility="Collapsed" />
                                                        <TextBlock x:Name="Line2StatusText" Text="Line 2  •  Idle" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        <Border x:Name="Line2VideoBadge" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" Visibility="Collapsed" Cursor="Hand" MouseDown="VideoBadge_MouseDown" ToolTip="Active Yeastar Video Call (Click to open video window)">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#7C3AED" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Video" FontSize="10" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock x:Name="Line2DetailText" Text="" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Line 2 Connected In-Call Controls Row (High-Quality Segoe Icons) -->
                                                <UniformGrid x:Name="Line2ActionRow" Columns="6" Height="32" Margin="0,8,0,2" Visibility="Collapsed" TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="14">
                                                    <Button x:Name="Line2HoldResumeButton" Content="&#xE769;" Style="{StaticResource LineIconActionButton}" Click="Line2HoldResumeButton_Click" ToolTip="Hold Call" />
                                                    <Button x:Name="Line2MuteButton" Content="&#xE720;" Style="{StaticResource LineIconActionButton}" Click="Line2MuteButton_Click" ToolTip="Mute Microphone" />
                                                    <Button x:Name="Line2TransferButton" Content="&#xE72A;" Style="{StaticResource LineIconActionButton}" Click="Line2TransferButton_Click" ToolTip="Transfer Call" />
                                                    <Button x:Name="Line2ConferenceButton" Content="&#xE716;" Style="{StaticResource LineIconActionButton}" Click="Line2ConferenceButton_Click" ToolTip="Conference Calls" />
                                                    <Button x:Name="Line2RecordButton" Content="&#xE7C8;" Style="{StaticResource LineIconActionButton}" Click="Line2RecordButton_Click" ToolTip="Record Call" />
                                                    <Button x:Name="Line2HangupButton" Content="&#xE778;" Style="{StaticResource LineDangerIconActionButton}" Click="Line2HangupButton_Click" ToolTip="End Call" />
                                                </UniformGrid>

                                                <!-- Line 2 Incoming Call Actions (Answer / Decline) -->
                                                <UniformGrid x:Name="Line2IncomingActionRow" Columns="2" Height="32" Margin="0,8,0,2" Visibility="Collapsed">
                                                    <Button x:Name="Line2AnswerButton" Style="{StaticResource LineSuccessIconActionButton}" Click="Line2AnswerButton_Click" ToolTip="Answer Incoming Call">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE717;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Answer" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="Line2DeclineButton" Style="{StaticResource LineDangerIconActionButton}" Click="Line2DeclineButton_Click" ToolTip="Decline Incoming Call">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE778;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Decline" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ROW 2: QUEUE LINE (Agilico Style: Shows when Queue Pickup is enabled) -->
                                <Border x:Name="QueueLineContainer"
                                        Grid.Row="2"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,10"
                                        Padding="12,7"
                                        Visibility="Collapsed">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                x:Name="FrontQueuePickupButton"
                                                Height="28"
                                                Padding="12,2"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Background="#F1F5F9"
                                                Foreground="#64748B"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Click="FrontQueuePickupButton_Click"
                                                ToolTip="Pick up queue call">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="QueueBtnBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE717;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock x:Name="QueueBtnText"
                                                                       Text="Pick up"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="QueueBtnBorder" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="QueueAccentBar" Width="3" Height="16" Background="#94A3B8" CornerRadius="1.5" Margin="0,0,8,0" />
                                            <TextBlock Text="Queues" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="QueueStatusText" Text="• Idle" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ROW 3: Dial Header -->
                                <DockPanel Grid.Row="3" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Dial" FontSize="14" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DestinationPreviewText" Text="" Foreground="#64748B" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <TextBlock x:Name="CallerLookupText" Text="" Foreground="#64748B" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>



                                <!-- ROW 4: DestinationTextBox and Clear -->
                                <Grid Grid.Row="4" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationTextBox" FontSize="16" Height="40" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D7E1EC" Background="#F9FBFE" TextChanged="DestinationTextBox_TextChanged" KeyDown="DestinationTextBox_KeyDown" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SoftButton}" Height="40" Margin="0" Click="ClearDestinationButton_Click" />
                                </Grid>

                                <!-- ROW 5: Keypad (Refined Modern Style) -->
                                <UniformGrid Grid.Row="5" Columns="3" Rows="4" Margin="-3,0,-3,8" VerticalAlignment="Stretch">
                                    <Button Tag="1" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="2" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 2 ABC">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="ABC" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="3" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 3 DEF">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="DEF" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="4" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 4 GHI">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="4" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="GHI" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="5" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 5 JKL">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="5" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="JKL" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="6" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 6 MNO">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="6" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="MNO" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="7" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 7 PQRS">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="7" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="PQRS" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="8" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 8 TUV">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="8" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="TUV" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="9" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 9 WXYZ">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="9" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="WXYZ" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="*" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Asterisk">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="*" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,-2" />
                                            <TextBlock Text="" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="0" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Digit 0 plus">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Text="+" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Height="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="#" Style="{StaticResource KeypadButton}" Click="DialpadButton_Click" AutomationProperties.Name="Pound Hash">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="#" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,1,0,-1" />
                                            <TextBlock Text="" Height="12" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- ROW 6: Dial -->
                                <Grid Grid.Row="6" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="DialButton" Content="Dial" Style="{StaticResource SoftButton}" Height="42" Background="{StaticResource PrimaryBrush}" Foreground="#0F172A" FontWeight="Bold" Click="DialButton_Click" Margin="0,0,6,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Dial" />
                                    <Button Grid.Column="1" x:Name="VideoDialButton" Style="{StaticResource SoftButton}" Height="42" Width="48" Background="#F5F3FF" BorderBrush="#DDD6FE" Foreground="#7C3AED" FontWeight="Bold" Click="VideoDialButton_Click" ToolTip="Start Video Call (Yeastar SIP/WebRTC)" AutomationProperties.Name="Video Dial">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="HangupButton" Visibility="Collapsed" Width="0" Height="0" />
                                </Grid>

                                <!-- ROW 7: Quick Actions (Voicemail) -->
                                <Grid Grid.Row="7">
                                     <UniformGrid x:Name="InCallButtonsGrid" Visibility="Collapsed" Width="0" Height="0">
                                         <Button x:Name="MuteButton" Visibility="Collapsed" />
                                         <Button x:Name="HoldButton" Visibility="Collapsed" />
                                         <Button x:Name="RecordButton" Visibility="Collapsed" />
                                         <Button x:Name="ConferenceButton" Visibility="Collapsed" />
                                         <Button x:Name="TransferButton" Visibility="Collapsed" />
                                     </UniformGrid>
                                     <Grid x:Name="DialerQuickActionsGrid" Margin="0,-2,0,0">
                                         <Button x:Name="VoicemailButton" Style="{StaticResource SoftButton}" Height="38" Margin="0,2,0,2" HorizontalAlignment="Stretch" Click="VoicemailButton_Click" ToolTip="Call Voicemail (*2)" AutomationProperties.Name="Voicemail">
                                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                 <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                 <TextBlock x:Name="VoicemailButtonText" Text="Voicemail" VerticalAlignment="Center" />
                                             </StackPanel>
                                         </Button>
                                     </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Directory" Foreground="#111827" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Grid.Row="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="8" Padding="3" Margin="0,0,0,14" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="DirTabHistoryBtn" Content="History" Style="{StaticResource SegmentedTabButton}" Click="ShowDirectoryHistoryButton_Click" />
                                        <Button x:Name="DirTabContactsBtn" Content="Contacts" Style="{StaticResource SegmentedTabButton}" Click="ShowDirectoryContactsButton_Click" />
                                        <Button x:Name="DirTabFavoritesBtn" Content="Favorites" Style="{StaticResource SegmentedTabButton}" Click="ShowDirectoryFavoritesButton_Click" />
                                    </StackPanel>
                                </Border>

                                <TabControl x:Name="DirectoryTabs" Grid.Row="1" Margin="0,54,0,0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </TabControl.Resources>
                                    <TabItem x:Name="DirectoryHistoryTab" Header="History">
                                        <ListBox x:Name="RecentCallsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="RecentCallsListView_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#F1F5F9" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="85" />
                                                                <ColumnDefinition Width="34" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="" />
                                                            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Foreground="#475569" Margin="6,8" />
                                                            <TextBlock Grid.Column="2" Text="Number" FontWeight="SemiBold" Foreground="#475569" Margin="6,8" />
                                                            <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="6,8" />
                                                            <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="6,8" />
                                                            <TextBlock Grid.Column="5" Text="Quality" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="6,8" />
                                                            <TextBlock Grid.Column="6" Text="" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,2" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="85" />
                                                                <ColumnDefinition Width="34" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Avatar Initials -->
                                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#EEF2F6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Initials}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Name & Direction -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                                <TextBlock Text="{Binding Name}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DirectionIcon}" Foreground="{Binding DirectionColor}" FontSize="10" FontWeight="Medium" />
                                                            </StackPanel>

                                                            <!-- Number -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Number}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0" />

                                                            <!-- Duration -->
                                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                            <!-- Result Badge -->
                                                            <Border Grid.Column="4" Background="{Binding ResultBadgeBackground}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBadgeForeground}" FontWeight="SemiBold" FontSize="10" />
                                                            </Border>

                                                            <!-- Quality MOS Button -->
                                                            <Button Grid.Column="5"
                                                                    Tag="{Binding}"
                                                                    Click="InspectCallQualityButton_Click"
                                                                    Cursor="Hand"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="View call quality: latency, jitter, bitrate (Tx/Rx) and packet loss">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="QBadge" Background="{Binding QualityBadgeBackground}" CornerRadius="6" Padding="6,2">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding QualitySummaryDisplay}" Foreground="{Binding QualityBadgeForeground}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                                                                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="7" Foreground="{Binding QualityBadgeForeground}" Margin="4,1,0,0" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="QBadge" Property="Opacity" Value="0.8" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- 1-Click Call-Back Button -->
                                                            <Button Grid.Column="6"
                                                                    Tag="{Binding}"
                                                                    Click="CallbackHistoryButton_Click"
                                                                    Cursor="Hand"
                                                                    Width="26"
                                                                    Height="26"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="Call back">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="CbBdr" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="13">
                                                                            <TextBlock x:Name="CbIcon" Text="&#xE717;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="CbBdr" Property="Background" Value="#16A34A" />
                                                                                <Setter TargetName="CbBdr" Property="BorderBrush" Value="#16A34A" />
                                                                                <Setter TargetName="CbIcon" Property="Foreground" Value="White" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>

                                    <TabItem x:Name="DirectoryContactsTab" Header="Contacts">
                                        <ListBox x:Name="DialContactsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#F1F5F9" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="68" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#475569" Margin="12,8" />
                                                            <TextBlock Grid.Column="1" Text="Company" FontWeight="SemiBold" Foreground="#475569" Margin="8" />
                                                            <TextBlock Grid.Column="2" Text="Number" FontWeight="SemiBold" Foreground="#475569" Margin="8" />
                                                            <TextBlock Grid.Column="3" Text="BLF" FontWeight="SemiBold" Foreground="#475569" Margin="8" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#FFFFFF">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="68" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="12,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="#475569" Margin="8,10" TextTrimming="CharacterEllipsis" />

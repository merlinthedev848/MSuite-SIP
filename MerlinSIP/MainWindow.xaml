<Window x:Class="MerlinSip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP"
        Icon="Assets/CKMedia-Icon.ico"
        Width="1420"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#111317">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F9FAFB" Offset="0" />
            <GradientStop Color="#F9FAFB" Offset="0.56" />
            <GradientStop Color="#F3F4F6" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#FFFFFF" Offset="0.62" />
            <GradientStop Color="#F9FAFB" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DialFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F3F4F6" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideRailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1C1917" Offset="0" />
            <GradientStop Color="#111317" Offset="0.64" />
            <GradientStop Color="#0C0A09" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FCD34D" Offset="0" />
            <GradientStop Color="#FBBF24" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF4444" Offset="0" />
            <GradientStop Color="#B91C1C" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.08" Color="#1E293B" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111317" />
            <Setter Property="Background" Value="{StaticResource DialFaceBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.06" Color="#1E293B" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FCD34D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.03" Color="#1E293B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource DialButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="IconSoftButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SettingsTabButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111317" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.06" Color="#1E293B" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FCD34D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContactCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#1E293B" />
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#1E293B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FCD34D" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#1E293B" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#1E293B" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#FEF3C7" />
                                <Setter Property="Foreground" Value="#D97706" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresenceContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#0F172A" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresenceMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource AppBackdrop}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SideRailBrush}" Padding="16,22" BorderThickness="0,0,1,0" BorderBrush="#1F2937">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.15" Color="#000000" />
                        </Border.Effect>
                        <Image Source="Assets/CKMedia-Icon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Merlin" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0" TextAlignment="Center" />
                    <TextBlock Text="SIP" Foreground="#8FA0B7" FontSize="10" TextAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,54,0,0">
                    <Button Content="Dial" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowDialButton_Click" />
                    <Button Content="Contacts" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowContactsButton_Click" />
                    <Button Content="Calls" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowCallsButton_Click" />
                    <Button Content="Messages" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowMessagesButton_Click" Visibility="Collapsed" />
                    <Button Content="Settings" Style="{StaticResource SoftButton}" Click="OpenSettingsButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <TextBlock x:Name="LicenseStatusText"
                               Text="Licensed"
                               Foreground="#8FA0B7"
                               FontSize="10"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AppVersionText"
                               Text="v1.3.1"
                               Foreground="#64748B"
                               FontSize="10"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="560" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="NoticeText" Text="" Visibility="Collapsed" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="430"
                        HorizontalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#D4C9B3"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Color="#4A3B22" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search or dial"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 x:Name="GlobalSearchTextBox"
                                 Height="34"
                                 Padding="10,6"
                                 VerticalAlignment="Center"
                                 BorderBrush="#E2E8F0"
                                 Background="#F8FBFE"
                                 ToolTip="Type a number or contact name, then press Enter"
                                 TextChanged="GlobalSearchTextBox_TextChanged"
                                 KeyDown="GlobalSearchTextBox_KeyDown" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PresenceButton"
                            Style="{StaticResource SoftButton}"
                            MinWidth="108"
                            Height="40"
                            Padding="12,0"
                            Margin="0"
                            VerticalAlignment="Center"
                            Click="PresenceButton_Click"
                            ToolTip="Set your presence status">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="PresenceDot" Width="8" Height="8" Fill="#16A34A" Stroke="#111317" StrokeThickness="1" Margin="0,0,7,0" />
                            <TextBlock x:Name="PresenceText" Text="Available" Margin="0,0,6,0" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PresenceContextMenu"
                                         Style="{StaticResource PresenceContextMenuStyle}"
                                         PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Button}}"
                                         Placement="Bottom"
                                         VerticalOffset="4">
                                <MenuItem Tag="Available" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Available">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#10B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Available" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="Busy" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Busy">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#EF4444" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Busy" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="DND" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Do Not Disturb">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#EF4444" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Rectangle Width="10" Height="2.5" Fill="White" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="DND" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="Away" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Away">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Away" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Tag="Offline" Click="PresenceMenuItem_Click" Style="{StaticResource PresenceMenuItemStyle}" ToolTip="Set status to Offline">
                                    <MenuItem.Header>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#94A3B8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Offline" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>
                <TabItem x:Name="PhoneTab" Header="Phone">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Row 0: Header "Calls" -->
                                    <RowDefinition Height="Auto" /> <!-- Row 1: Dual Lines Box -->
                                    <RowDefinition Height="Auto" /> <!-- Row 2: Live Call Telemetry HUD -->
                                    <RowDefinition Height="Auto" /> <!-- Row 3: Dial Header -->
                                    <RowDefinition Height="Auto" /> <!-- Row 4: DestinationTextBox & Clear -->
                                    <RowDefinition Height="240" />  <!-- Row 5: Keypad -->
                                    <RowDefinition Height="Auto" /> <!-- Row 6: Dial / Redial / Hangup -->
                                    <RowDefinition Height="Auto" /> <!-- Row 7: InCall & Quick Actions -->
                                    <RowDefinition Height="Auto" /> <!-- Row 8: DTMF Footer -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Top Header: Calls + Audio/Timer/Quality -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="CallQualityPill"
                                                Background="#EEF4FB"
                                                CornerRadius="7"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="CallQualityText" Text="HD Voice" FontSize="11" FontWeight="SemiBold" Foreground="#2750A7" />
                                        </Border>
                                        <Border x:Name="CallTimerPill"
                                                Background="#FFE2E2"
                                                CornerRadius="7"
                                                Padding="9,4"
                                                Margin="0,0,8,0">
                                            <TextBlock x:Name="CallTimerText" Text="Inactive" FontWeight="SemiBold" Foreground="#9B1C1C" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" ToolTip="Audio Headset Ready" />
                                    </StackPanel>
                                    <TextBlock Text="Calls" Foreground="#111827" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- ROW 1: DUAL-LINE CALLS CONTAINER (Agilico Style: Line 1 & Line 2) -->
                                <Border x:Name="LinesContainer"
                                        Grid.Row="1"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,12"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" MinHeight="62" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" MinHeight="62" />
                                        </Grid.RowDefinitions>

                                        <!-- LINE 1 -->
                                        <Border x:Name="Line1Card"
                                                Grid.Row="0"
                                                Background="#F0FDF4"
                                                CornerRadius="9,9,0,0"
                                                Padding="14,10"
                                                Cursor="Hand"
                                                MouseDown="Line1Card_MouseDown"
                                                ToolTip="Line 1 (Click to select)">
                                            <DockPanel LastChildFill="True">
                                                <!-- Line 1 Number Indicator on the right (like Agilico '1') -->
                                                <Border DockPanel.Dock="Right" x:Name="Line1Badge" Background="Transparent" VerticalAlignment="Center" Margin="12,0,4,0">
                                                    <TextBlock x:Name="Line1BadgeText"
                                                               Text="1"
                                                               FontWeight="SemiBold"
                                                               FontSize="18"
                                                               Foreground="#0E987E"
                                                               HorizontalAlignment="Center" />
                                                </Border>

                                                <!-- Line 1 Actions -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Button x:Name="Line1HoldResumeButton"
                                                            Content="⏸ Hold"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Padding="7,3"
                                                            Margin="0,0,4,0"
                                                            Visibility="Collapsed"
                                                            Style="{StaticResource SoftButton}"
                                                            Click="Line1HoldResumeButton_Click"
                                                            ToolTip="Hold or resume Line 1" />
                                                    <Button x:Name="Line1HangupButton"
                                                            Content="✕"
                                                            Foreground="#EF4444"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Padding="7,3"
                                                            Visibility="Collapsed"
                                                            Style="{StaticResource SoftButton}"
                                                            Click="Line1HangupButton_Click"
                                                            ToolTip="End Line 1 call" />
                                                </StackPanel>

                                                <!-- Line 1 Status & Details -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="Line1StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="Line1Title" Text="Line 1" FontWeight="Bold" FontSize="13" Foreground="#111827" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="Line1StatusText" Text="Idle" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="Line1DetailText"
                                                               Text="Ready for call"
                                                               FontSize="12"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="16,3,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Divider Line -->
                                        <Rectangle Grid.Row="1" Fill="#E2E8F0" Height="1" />

                                        <!-- LINE 2 -->
                                        <Border x:Name="Line2Card"
                                                Grid.Row="2"
                                                Background="#FFFFFF"
                                                CornerRadius="0,0,9,9"
                                                Padding="14,10"
                                                Cursor="Hand"
                                                MouseDown="Line2Card_MouseDown"
                                                ToolTip="Line 2 (Click to select for second call or answering incoming)">
                                            <DockPanel LastChildFill="True">
                                                <!-- Line 2 Number Indicator on the right (like Agilico '2') -->
                                                <Border DockPanel.Dock="Right" x:Name="Line2Badge" Background="Transparent" VerticalAlignment="Center" Margin="12,0,4,0">
                                                    <TextBlock x:Name="Line2BadgeText"
                                                               Text="2"
                                                               FontWeight="SemiBold"
                                                               FontSize="18"
                                                               Foreground="#94A3B8"
                                                               HorizontalAlignment="Center" />
                                                </Border>

                                                <!-- Line 2 Actions (Answer/Decline or Hold/Hangup) -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Button x:Name="Line2AnswerButton"
                                                            Content="Answer"
                                                            Background="#10B981"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            FontSize="11"
                                                            Padding="8,3"
                                                            Margin="0,0,4,0"
                                                            Visibility="Collapsed"
                                                            Click="Line2AnswerButton_Click"
                                                            ToolTip="Answer incoming call on Line 2" />
                                                    <Button x:Name="Line2DeclineButton"
                                                            Content="Decline"
                                                            Background="#EF4444"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            FontSize="11"
                                                            Padding="8,3"
                                                            Margin="0,0,4,0"
                                                            Visibility="Collapsed"
                                                            Click="Line2DeclineButton_Click"
                                                            ToolTip="Decline incoming call on Line 2" />
                                                    <Button x:Name="Line2HoldResumeButton"
                                                            Content="⏸ Hold"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Padding="7,3"
                                                            Margin="0,0,4,0"
                                                            Visibility="Collapsed"
                                                            Style="{StaticResource SoftButton}"
                                                            Click="Line2HoldResumeButton_Click"
                                                            ToolTip="Hold or resume Line 2" />
                                                    <Button x:Name="Line2HangupButton"
                                                            Content="✕"
                                                            Foreground="#EF4444"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Padding="7,3"
                                                            Visibility="Collapsed"
                                                            Style="{StaticResource SoftButton}"
                                                            Click="Line2HangupButton_Click"
                                                            ToolTip="End Line 2 call" />
                                                </StackPanel>

                                                <!-- Line 2 Status & Details -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="Line2StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="Line2Title" Text="Line 2" FontWeight="Bold" FontSize="13" Foreground="#111827" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="Line2StatusText" Text="Idle" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="Line2DetailText"
                                                               Text="Ready for 2nd call / Incoming"
                                                               FontSize="12"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="16,3,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ROW 2: Live In-Call Quality & Telemetry HUD -->
                                <Border Grid.Row="2"
                                        x:Name="LiveCallStatisticsCard"
                                        Background="#F0FDF4"
                                        BorderBrush="#BBF7D0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed"
                                        Cursor="Hand"
                                        MouseDown="LiveCallStatisticsCard_MouseDown"
                                        ToolTip="Live VoIP RTP stream diagnostics. Click to open detailed Call Quality Analysis.">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0">
                                            <Border DockPanel.Dock="Right" x:Name="LiveQualityBadge" Background="#DEF7EC" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="LiveQualityLevelText" Text="🟢 4.4 MOS • Excellent" Foreground="#03543F" FontWeight="Bold" FontSize="11.5" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="LIVE CALL TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LiveCodecText" Text=" • PCMU 64k" FontSize="10" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>

                                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,8,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="LOSS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="LiveLossText" Text="0.0%" FontSize="13.5" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="JITTER" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="LiveJitterText" Text="1.8 ms" FontSize="13.5" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="LATENCY" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="LiveLatencyText" Text="22 ms" FontSize="13.5" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="SIGNAL" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="LiveSignalText" Text="5/5 Bars" FontSize="13.5" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <!-- ROW 3: Dial Header (Agilico style ::: Dial ^) -->
                                <DockPanel Grid.Row="3" Margin="0,2,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE75F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#111827" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Dial" FontSize="14" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DestinationPreviewText" Text="" Foreground="#64748B" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <TextBlock x:Name="CallerLookupText" Text="" Foreground="#64748B" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- ROW 4: DestinationTextBox and Clear -->
                                <Grid Grid.Row="4" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationTextBox" FontSize="16" Padding="12,10" BorderBrush="#D7E1EC" Background="#F9FBFE" TextChanged="DestinationTextBox_TextChanged" KeyDown="DestinationTextBox_KeyDown" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SoftButton}" Click="ClearDestinationButton_Click" />
                                </Grid>

                                <!-- ROW 5: Keypad -->
                                <UniformGrid Grid.Row="5" Columns="3" Rows="4" Margin="0,0,0,14" VerticalAlignment="Top">
                                    <Button Content="1" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="2" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="3" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="4" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="5" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="6" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="7" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="8" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="9" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="*" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="0" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="#" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                </UniformGrid>

                                <!-- ROW 6: Dial / Redial / Hangup -->
                                <Grid Grid.Row="6" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" x:Name="DialButtonColumn" />
                                        <ColumnDefinition Width="Auto" x:Name="RedialButtonColumn" />
                                        <ColumnDefinition Width="0" x:Name="HangupButtonColumn" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="DialButton" Content="Dial" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="DialButton_Click" Margin="0" />
                                    <Button Grid.Column="1" x:Name="RedialButton" Content="⟲ Redial" Style="{StaticResource SoftButton}" Width="95" Margin="8,0,0,0" Click="RedialButton_Click" ToolTip="Redial last number" AutomationProperties.Name="Redial" />
                                    <Button Grid.Column="2" x:Name="HangupButton" Content="&#xE778;" Style="{StaticResource IconSoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="HangupButton_Click" Visibility="Collapsed" Margin="0" ToolTip="Hang up" AutomationProperties.Name="Hang up" />
                                </Grid>

                                <!-- ROW 7: InCall Buttons & Quick Actions -->
                                <Grid Grid.Row="7">
                                     <UniformGrid x:Name="InCallButtonsGrid" Columns="5" Rows="1" Visibility="Collapsed" Margin="0,-2,0,0">
                                         <Button x:Name="MuteButton" Content="&#xE720;" Style="{StaticResource IconSoftButton}" Click="MuteButton_Click" Margin="0,2,3,2" ToolTip="Mute" AutomationProperties.Name="Mute" />
                                         <Button x:Name="HoldButton" Content="&#xE769;" Style="{StaticResource IconSoftButton}" Click="HoldButton_Click" Margin="3,2,3,2" ToolTip="Hold" AutomationProperties.Name="Hold" />
                                         <Button x:Name="RecordButton" Content="&#xE7C8;" Style="{StaticResource IconSoftButton}" Click="RecordButton_Click" Margin="3,2,3,2" ToolTip="Record Call" AutomationProperties.Name="Record Call" />
                                         <Button x:Name="ConferenceButton" Content="&#xE716;" Style="{StaticResource IconSoftButton}" Click="ConferenceButton_Click" Margin="3,2,3,2" ToolTip="Conference" AutomationProperties.Name="Conference" />
                                         <Button x:Name="TransferButton" Content="&#xE72A;" Style="{StaticResource IconSoftButton}" Click="TransferButton_Click" Margin="3,2,0,2" ToolTip="Transfer" AutomationProperties.Name="Transfer" />
                                     </UniformGrid>
                                     <UniformGrid x:Name="DialerQuickActionsGrid" Columns="2" Rows="1" Margin="0,-2,0,0">
                                         <Button x:Name="VoicemailButton" Style="{StaticResource SoftButton}" Margin="0,2,4,2" Click="VoicemailButton_Click" ToolTip="Call Voicemail (*97)" AutomationProperties.Name="Voicemail">
                                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                 <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                 <TextBlock x:Name="VoicemailButtonText" Text="Voicemail" VerticalAlignment="Center" />
                                             </StackPanel>
                                         </Button>
                                         <Button x:Name="DndButton" Content="DND" Style="{StaticResource SoftButton}" Margin="4,2,0,2" Click="DndButton_Click" ToolTip="Do Not Disturb" AutomationProperties.Name="DND" />
                                     </UniformGrid>
                                </Grid>

                                <!-- ROW 8: Footnote -->
                                <TextBlock Grid.Row="8"
                                           Text="DTMF input is sent directly during live calls."
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Directory" Foreground="#111827" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                                 <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Left" Width="360" Margin="0,0,0,12" VerticalAlignment="Top">
                                    <Button Content="History" Style="{StaticResource SoftButton}" Margin="0,0,4,0" Click="ShowDirectoryHistoryButton_Click" />
                                    <Button Content="Contacts" Style="{StaticResource SoftButton}" Margin="4,0,4,0" Click="ShowDirectoryContactsButton_Click" />
                                    <Button Content="Favorites" Style="{StaticResource SoftButton}" Margin="4,0,0,0" Click="ShowDirectoryFavoritesButton_Click" />
                                </UniformGrid>

                                <TabControl x:Name="DirectoryTabs" Grid.Row="1" Margin="0,54,0,0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </TabControl.Resources>
                                    <TabItem x:Name="DirectoryHistoryTab" Header="History">
                                        <ListBox x:Name="RecentCallsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="RecentCallsListView_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#EFECE6" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.1*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="95" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#78716C" Margin="12,8" />
                                                            <TextBlock Grid.Column="1" Text="Number" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                            <TextBlock Grid.Column="2" Text="Duration" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                            <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                            <TextBlock Grid.Column="4" Text="Quality" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#FDFBF7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="95" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="12,10">
                                                            <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DirectionIcon}" Foreground="#78716C" FontSize="12" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#78716C" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#78716C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        <Border Grid.Column="3" Background="{Binding ResultBadgeBackground}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBadgeForeground}" FontWeight="SemiBold" FontSize="12" />
                                                        </Border>
                                                        <Border Grid.Column="4" Background="{Binding QualityBadgeBackground}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mean Opinion Score (MOS) and Quality Level">
                                                            <TextBlock Text="{Binding QualitySummaryDisplay}" Foreground="{Binding QualityBadgeForeground}" FontWeight="SemiBold" FontSize="11" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>

                                    <TabItem x:Name="DirectoryContactsTab" Header="Contacts">
                                        <ListBox x:Name="DialContactsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#EFECE6" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#78716C" Margin="12,8" />
                                                            <TextBlock Grid.Column="1" Text="Company" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                            <TextBlock Grid.Column="2" Text="Number" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                            <TextBlock Grid.Column="3" Text="BLF" FontWeight="SemiBold" Foreground="#78716C" Margin="8" HorizontalAlignment="Center" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#FDFBF7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="12,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="#78716C" Margin="8,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Number}" Foreground="#D97706" FontWeight="SemiBold" Margin="8,10" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="3" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" Stroke="#111317" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding PresenceLabel}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" FontSize="12" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                    <TabItem x:Name="DirectoryFavoritesTab" Header="Favorites">
                                        <ListBox x:Name="DialFavoritesListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="FavoritesListView_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#EFECE6" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#78716C" Margin="12,8" />
                                                            <TextBlock Grid.Column="1" Text="Company" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                            <TextBlock Grid.Column="2" Text="Number" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                            <TextBlock Grid.Column="3" Text="BLF" FontWeight="SemiBold" Foreground="#78716C" Margin="8" HorizontalAlignment="Center" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#FDFBF7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="12,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="#78716C" Margin="8,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Number}" Foreground="#D97706" FontWeight="SemiBold" Margin="8,10" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="3" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" Stroke="#111317" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding PresenceLabel}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" FontSize="12" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ContactsTab" Header="Contacts">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.75*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="Call selected" Style="{StaticResource SoftButton}" Width="130" Click="UseSelectedContactButton_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Contacts" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="PhonebookContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" SelectionChanged="PhonebookContactsListView_SelectionChanged" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="7,4" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" Stroke="#111317" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PresenceLabel}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Number}" Foreground="#D97706" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,2" />
                                                    <TextBlock Text="{Binding Company}" Foreground="#78716C" />
                                                    <TextBlock Text="{Binding Notes}" Foreground="#94A3B8" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <StackPanel>
                                <TextBlock Text="Contact details" Foreground="#111827" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Name" Foreground="#64748B" FontWeight="Medium" Margin="0,16,0,4" />
                                <TextBox x:Name="ContactNameTextBox" KeyDown="ContactTextBox_KeyDown" />
                                <TextBlock Text="Number" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNumberTextBox" KeyDown="ContactTextBox_KeyDown" />
                                <TextBlock Text="Company" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactCompanyTextBox" KeyDown="ContactTextBox_KeyDown" />
                                <TextBlock Text="Notes" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNotesTextBox" AcceptsReturn="True" Height="96" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <CheckBox x:Name="ContactIsFavoriteCheckBox" Content="Add to favorites / speed dial" Foreground="#111827" FontWeight="SemiBold" Margin="0,4,0,14" />
                                <Button Content="Save contact" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,0,10" Click="SaveContactButton_Click" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Delete selected" Style="{StaticResource SoftButton}" Click="DeleteContactButton_Click" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" x:Name="NewContactButton" Content="New / Clear" Style="{StaticResource SoftButton}" Click="NewContactButton_Click" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CallsTab" Header="Calls">
                    <Border Style="{StaticResource Surface}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="QualityAnalysisButton" Content="📊 Call Quality Analysis" Style="{StaticResource SoftButton}" Width="168" Margin="0,0,10,0" Click="QualityAnalysisButton_Click" ToolTip="View comprehensive VoIP call quality and MOS analytics" />
                                    <Button Content="Clear history" Style="{StaticResource SoftButton}" Width="110" Click="ClearHistoryButton_Click" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Calls" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="CallHistoryListView" Grid.Row="1" BorderThickness="0" Background="Transparent" MouseDoubleClick="CallHistoryListView_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Background="#EFECE6" Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#78716C" Margin="12,8" />
                                                <TextBlock Grid.Column="1" Text="Number" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                <TextBlock Grid.Column="2" Text="Date/Time" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                <TextBlock Grid.Column="5" Text="Quality" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                <TextBlock Grid.Column="6" Text="Details" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                            </Grid>
                                            <ScrollViewer Focusable="False">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1" Background="#FDFBF7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10">
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DirectionIcon}" Foreground="#78716C" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#78716C" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding StartedAt}" Foreground="#78716C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#78716C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <Border Grid.Column="4" Background="{Binding ResultBadgeBackground}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBadgeForeground}" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <Border Grid.Column="5" Background="{Binding QualityBadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mean Opinion Score (MOS) and Quality Level">
                                                <TextBlock Text="{Binding QualitySummaryDisplay}" Foreground="{Binding QualityBadgeForeground}" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <Button Grid.Column="6" Content="Inspect" Style="{StaticResource SoftButton}" Height="28" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center" Click="InspectCallQualityButton_Click" Tag="{Binding}" ToolTip="Inspect full VoIP RTP quality analysis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="MessagesTab" Header="Messages" Visibility="Collapsed">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right"
                                            Content="Clear chat"
                                            Style="{StaticResource SoftButton}"
                                            Background="{StaticResource DangerBrush}"
                                            Foreground="White"
                                            Width="92"
                                            Height="34"
                                            FontSize="12"
                                            Padding="8,0"
                                            Click="ClearChatThreadButton_Click" />
                                    <StackPanel>
                                        <TextBlock x:Name="ChatThreadTitleText" Text="Choose a conversation" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                        <TextBlock x:Name="ChatThreadSubtitleText" Text="" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="ChatMessagesListView" Grid.Row="1" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FBFE" BorderBrush="#EAF1F8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="#F8FBFE" CornerRadius="7" Padding="8,5">
                                                            <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="SemiBold" FontSize="12" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SentAt}" Foreground="#64748B" FontSize="12" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="#334155" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageBodyTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="46"
                                                 MaxHeight="98"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="MessageBodyTextBox_KeyDown" />
                                        <Button Grid.Column="1"
                                                x:Name="SendMessageButton"
                                                Content="Send"
                                                Style="{StaticResource SoftButton}"
                                                Background="{StaticResource PrimaryBrush}"
                                                Foreground="White"
                                                Margin="10,0,0,0"
                                                Click="SendMessageButton_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Conversations" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
                                </StackPanel>
                                <TextBox x:Name="MessageToTextBox" Visibility="Collapsed" />
                                <ListBox x:Name="ChatContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ChatContactsListView_SelectionChanged" MouseDoubleClick="ChatContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Background="#F8FBFE" Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="135" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="10,8" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="6,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding Number}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border x:Name="FooterStatusBar" Grid.Row="2" Background="#FFF1D6" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,18,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.14" Color="#07111E" />
                </Border.Effect>
                <TextBlock x:Name="FooterStatusText" Text="Checking account connection" Foreground="#8A4F08" FontWeight="Medium" />
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#D9000000">
            <Border Style="{StaticResource Surface}" Width="840" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Panel -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" CornerRadius="8,0,0,8" Padding="16,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Title -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Preferences &amp; System" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            
                            <!-- Sidebar Tabs -->
                            <StackPanel Grid.Row="1">
                                <Button x:Name="TabBtnGeneral" Content="⚙️  General" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsGeneralButton_Click" Margin="0,0,0,5" AutomationProperties.Name="General Settings" />
                                <Button x:Name="TabBtnAccount" Content="👤  Account &amp; SIP" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsAccountButton_Click" Margin="0,0,0,5" AutomationProperties.Name="Account and SIP Settings" />
                                <Button x:Name="TabBtnAudio" Content="🔊  Audio &amp; Tunes" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsAudioButton_Click" Margin="0,0,0,5" AutomationProperties.Name="Audio and Ringtones Settings" />
                                <Button x:Name="TabBtnHandling" Content="🔀  Call Routing" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsHandlingButton_Click" Margin="0,0,0,5" AutomationProperties.Name="Call Routing Settings" />
                                <Button x:Name="TabBtnDiagnostics" Content="🛠️  Diagnostics" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsDiagnosticsButton_Click" Margin="0,0,0,5" AutomationProperties.Name="Diagnostics and Updates" />
                                <Button x:Name="TabBtnAbout" Content="ℹ️  About" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsAboutButton_Click" Margin="0,0,0,5" AutomationProperties.Name="About Merlin SIP" />
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Grid.Row="2" Content="Close" Style="{StaticResource SoftButton}" HorizontalAlignment="Stretch" Click="CloseSettingsButton_Click" AutomationProperties.Name="Close Settings" />
                        </Grid>
                    </Border>

                    <!-- Settings Content Panel -->
                    <Grid Grid.Column="1" Margin="20,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TabControl Grid.Row="0" x:Name="SettingsTabs" Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                                
                                <!-- Compact Corporate styles for settings controls -->
                                <Style TargetType="TextBox">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="8,2,28,2" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="MaxDropDownHeight" Value="220" />
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                </Style>
                                <Style x:Key="SettingsCard" TargetType="Border">
                                    <Setter Property="Padding" Value="14" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                </Style>
                                <Style TargetType="Slider">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </TabControl.Resources>

                            <!-- Tab 1: General Preferences -->
                            <TabItem x:Name="SettingsGeneralTab" Header="General">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,10,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <TextBlock Text="Call preferences" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="Do not disturb mode" />
                                                        <ComboBox x:Name="DndModeComboBox" Margin="0,0,0,4" AutomationProperties.Name="Do Not Disturb Mode">
                                                            <ComboBoxItem Content="Off" />
                                                            <ComboBoxItem Content="Reject calls" />
                                                            <ComboBoxItem Content="Silent ringing" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="When I decline a call" />
                                                        <ComboBox x:Name="DeclineActionComboBox" Margin="0,0,0,4" AutomationProperties.Name="Decline Action">
                                                            <ComboBoxItem Content="Send 603 Decline" />
                                                            <ComboBoxItem Content="Send busy" />
                                                            <ComboBoxItem Content="Send 480 Unavailable" />
                                                            <ComboBoxItem Content="Forward to mobile" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <TextBlock Text="Queue pickup" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <CheckBox x:Name="QueuePickupCheckBox" Content="Enable queue pickup shortcut" FontWeight="SemiBold" AutomationProperties.Name="Enable Queue Pickup" />
                                                <DockPanel Margin="0,4,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Pick up queue call" Style="{StaticResource SoftButton}" Height="28" Width="140" Click="QueuePickupButton_Click" AutomationProperties.Name="Pick Up Queue Call" />
                                                    <TextBlock Text="Uses *8 from this handset when queue pickup is enabled." Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <TextBlock Text="Search &amp; Display preferences" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

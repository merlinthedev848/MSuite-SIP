<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MerlinSip.Mac</RootNamespace>
    <AssemblyName>MerlinSIP</AssemblyName>
    <ApplicationTitle>Merlin SIP</ApplicationTitle>
    <Authors>CK Media Services</Authors>
    <Company>CK Media Services</Company>
    <Product>Merlin SIP</Product>
    <Version>1.3.9.2</Version>
    <AssemblyVersion>1.3.9.2</AssemblyVersion>
    <FileVersion>1.3.9.2</FileVersion>
    <Copyright>Copyright (c) CK Media Services</Copyright>
    <Description>Merlin SIP desktop softphone for macOS.</Description>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\MerlinSIP\Assets\CKMedia-Icon.png" Link="Assets\CKMedia-Icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

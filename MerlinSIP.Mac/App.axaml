<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="MerlinSip.Mac.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <fluent:FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI" />
      <Setter Property="Background" Value="#F3F4F6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#111317" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FBBF24" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F59E0B" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#DC2626" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.good">
      <Setter Property="Background" Value="#059669" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.key">
      <Setter Property="Height" Value="52" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#F8FAFC" />
    </Style>
    <Style Selector="Button.line">
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Ellipse.flash">
      <Style.Animations>
        <Animation Duration="0:0:0.45" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.15" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D7E1EC" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #140F172A" />
    </Style>
  </Application.Styles>
</Application>
